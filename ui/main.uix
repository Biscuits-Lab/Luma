<template>
  <div class="root">
    <div class="topbar">
      <label class="filename">{{ fileName }}</label>
    </div>
    <ImageView id="imageView" class="viewer" expand="true" />
    <div class="bottombar">
      <label class="info">{{ imageInfo }}</label>
      <label class="zoomText">{{ Math.round(zoom) }}%</label>
      <Slider class="zoomSlider" min="10" max="800" v-model="zoom" @changed="onZoomChanged" />
    </div>
  </div>
</template>

