<window title="Lumina" width="1280" height="820" centered="true" theme="dark" />

<script>
export default {
  data() {
    return {
      fileName: 'Lumina',
      imageInfo: 'Open an image to preview',
      zoom: 100
    };
  },
  methods: {
    onZoomChanged(value) {
      this.zoom = value;
    }
  }
}
</script>

<style>
.root {
  background: #0e0e10;
  color: #f4f4f5;
  flex-direction: column;
  width: 100%;
  height: 100%;
}

.topbar {
  height: 44px;
  padding: 10px 16px 8px 16px;
  align-items: center;
  justify-content: center;
  background: rgba(18, 18, 20, 0.82);
}

.filename {
  font-size: 13px;
  color: rgba(245, 245, 247, 0.88);
  font-weight: 500;
}

.viewer {
  flex: 1;
  background: #101014;
}

.bottombar {
  height: 54px;
  padding: 8px 18px 12px 18px;
  gap: 12px;
  align-items: center;
  background: rgba(18, 18, 20, 0.92);
}

.info {
  flex: 1;
  font-size: 12px;
  color: rgba(235, 235, 240, 0.82);
}

.zoomText {
  width: 56px;
  text-align: right;
